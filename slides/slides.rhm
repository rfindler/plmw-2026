#lang rhombus
import:
  "state_ex.rhm" open
  "sexp_to_tree.rhm" open
  "trees-with-subtrees.rhm" open
  "explain-evaluation-contexts.rhm" open
  "typeset.rkt"
  "typeset.rkt" ! model1
  "typeset.rkt" ! model2
  "typeset.rkt" ! model4
  draw
  slideshow open

// introduction:
// specification of a programming language starts with a description of its semantics
// but we can actually do the semantics that way too!
// you are familiar with this from grade school: "plug and chug" and simplification of arithmetic.
// mathematically: we are defining a relation that captures a single step of computation
//  and then just taking the trans refl closure to get the complete behavior of a program.

fun tp(x):
  t(x, ~font: draw.Font(~name: typeset.libertine, ~size: typeset.font_size)).colorize("brown")

slide(~title: tp("a first simple language: booleans"), model1.lang)
slide(~title: tp("axioms: rules for atomic computation steps"), beside.topline(~sep: 100, & model1.ax))
slide(~title: tp("what should happen when an axiom is nested: is that always ok? (no!)"), model1.ex)
slide(~title: tp("to see why, let’s first add state to the language"), model2.lang)
slide(~title: tp("the state axioms; also add a store"), stack.right(~sep: 50, Pict.from_handle(model2.schema),model2.new_ax))
slide(~title: tp("the other axioms have to adapt"), beside.topline(~sep: 50, & model2.bool_ax))
slide(~title: tp("let’s return to the question of nesting, but in a new example"), ex2_slide)
slide(~title: tp("expressions are really trees"),
      stack.left(~sep: 80,
                 beside(~sep: 100, model1.ex , to_pict(model1.ex_sexp)),
                 beside(~sep: 100, model2.ex , to_pict(model2.ex_sexp))))
slide(~title: tp("maybe big trees; we need to describe paths"),
      switch(abstract_big_tree(200,200,#false),
             abstract_big_tree(200,200,#true)).scale(2))
slide(~title: tp("evaluation contexts: paths from the root to the axiom use"),
      explain_evaluation_contexts)
slide(~title: tp("those rules aren’t the usual ones: can we fix them?"), ex2_with_new_rules)
slide(t("Careful—the next slide has the answer!"))
slide(~title: tp("we need only two evaluation contexts"), model4.ec_lang)
slide(~title: tp("some notation"), stack(~sep: 100,
                                         beside(~sep: 40, model4.decomp, abstract_big_tree(200,200,#true, ~line_width: 2).scale(2/3)),
                                         model4.red))

