#lang rhombus
import:
  "state_ex.rhm" open
  "sexp_to_tree.rhm" open
  "trees-with-subtrees.rhm" open
  "explain-evaluation-contexts.rhm" open
  "typeset.rkt"
  "exn.rhm" open
  "par.rhm" open
  "typeset.rkt" ! model1
  "typeset.rkt" ! model2
  "typeset.rkt" ! model4
  "typeset.rkt" ! model5
  "typeset.rkt" ! model6
  "typeset.rkt" ! model7
  "typeset.rkt" ! model8
  "typeset.rkt" ! model9
  "lib.rhm" open
  "../../logo/lockup.rhm"
  "trace.rhm" open
  draw
  slideshow open


slide(
  ~title: tp(stack(
               ~horiz: #'left,
               @t{Reduction Semantics &},
               @t{How to Read Them},
             ).pad(~vert: 10).scale(3)),
  lockup.horizontal_purple().pad(~top: 140)
)

slide(
  ~title: tp("reduction semantics"),
  stack.right(
    ~sep:60,
    t("specification of a PL: start with syntax"),
    beside.topline(t("the "),
                   t(~font: current_font() with (weight = #'bold), "semantics"),
                   t(" also works via the syntax")),
    stack.right(t("basics are the same as grade-school math:"),
                t("plug and chug")),
    stack.right(t("formally, a binary relation on syntax"),
                t("that captures steps of computation"))
  )
)

slide(~title: tp("a first simple language: booleans"), model1.lang)
slide(~title: tp("axioms: rules for atomic computation steps"), beside.topline(~sep: 100, & model1.ax))
slide(~title: tp("what should happen when an axiom is nested: is that always ok? (no!)"), model1.ex)
slide(~title: tp("to see why, let’s first add state to the language"), model2.lang)
slide(~title: tp("the state axioms; also add a store"), stack.right(~sep: 50, Pict.from_handle(model2.schema),model2.new_ax))
slide(~title: tp("the other axioms have to adapt"), stack(~sep: 80,
                                                          beside.topline(~sep: 60, model2.bool_ax[0], model2.bool_ax[1]),
                                                          model2.bool_ax[2]))
slide(~title: tp("let’s return to the question of nesting, but in a new example"), ex2_slide)
slide(~title: tp("expressions are really trees"),
      stack.left(~sep: 80,
                 beside(~sep: 100, model1.ex , to_pict(model1.ex_sexp)),
                 beside(~sep: 100, model2.ex , to_pict(model2.ex_sexp))))
slide(~title: tp("evaluation contexts: paths from the root to the axiom use"),
      explain_evaluation_contexts)
slide(~title: tp("those rules aren’t the usual ones: can we fix them?"), ex2_with_new_rules)
slide(tp("careful—the next slide has the answer!"))
slide(~title: tp("we need only one evaluation context each"),
      beside(~sep: 100,
             model4.ec_lang,
             stack(~sep: 40, & model4.ax)))
slide(~title: tp("some notation"), stack(~sep: 160,
                                         beside(~sep: 40, model4.decomp, abstract_big_tree(200,200,#true, ~line_width: 3).scale(2/3)),
                                         model4.red))
slide(~title: tp("functions"),
      beside.baseline(~sep: 200,
                      stack(~sep: 40, model5.ec_cbv, model5.ax_cbv),
                      stack(~sep: 40, model5.ec_cbn, model5.ax_cbn)))
slide(~title: tp("exceptions: controlling the future of the computation"),
      switch(
        exn_explanation,
        stack(~sep: 60,
              beside.topline(~sep: 100, model6.lang_e, model6.lang_ec),
              stack.center(~sep: 60, & model6.red))
      ))
slide(~title: tp("continuations"),
      stack(~sep: 60,
            beside.topline(~sep: 100, model7.lang_e, model7.lang_ec),
            stack.center(~sep: 60, & model7.red)))
slide(~title: tp("sequentially consistent parallelism (no new axioms required)"),
      switch(stack(~sep: 100,
                   beside.topline(~sep: 100, model8.lang_e, model8.lang_ec)),
             overlay.top_right(model8.lang_ec,
                               step_through_an_example(model8.ex_and_store_sexp))))

slide(~title: tp("a taste of esterel: parallelism and determinism"),
      overlay.top_right(stack.left(~sep: 60, & model9.red),
                        model8.lang_ec.pad(~left: 0,~top: 60)))
      
slide(
  ~title: tp("reduction semantics"),
  stack.left(
    ~sep:50,
    t("semantics via syntax using evaluation contexts"),
    stack.left(
      beside.baseline(t(~font: current_font() with (weight = #'bold), "redex: "), t("a PL for writing semantics")),
      t("http://www.github.com/rfindler/plmw-2026/")
    ),
    stack.left(
      t(~font: current_font() with (weight = #'bold), "ICFP 2026 papers that use what you’ve learned:"),
      stack.left(
        t("A Separation Logic for Parallel Time Complexity with Work and Span Credits"),
        t("Adequacy for Predicate Transformer Semantics"),
        t("An Exploration of First-Class Constrained Types"),
        t("Completeness of Iris-Based Program Logics"),
        t("Demand-on-Demand Control-Flow Analysis"),
        t("HMCFA: A Precise and Practical Big-Step Control Flow Analysis for Effect Handlers"),
        stack.left(t("Inlining as a space optimization: a simple time- and space-invariant"),
                   beside.baseline(blank(~width:20), t("implementation of the weak lambda-calculus"))),
        t("Tail Modulo Async-Await"),
        t("When Types Intersect and Effects Get Handled"),
      ).scale(.8)
    )
  )
)
