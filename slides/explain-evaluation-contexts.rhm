#lang rhombus
import:
  "typeset.rkt" ! model2
  "typeset.rkt" ! model3
  "typeset.rkt" ! model4
  slideshow open

export:
  explain_evaluation_contexts
  ex2_with_new_rules

def first_term = stack.left(
  ~sep: 40,
  model2.ex_1,
  model2.get_ax,
  model2.set_ax
  )

def second_term = stack.left(
  ~sep: 40,
  model2.ex,
  model2.let_ax
  )

def explain_evaluation_contexts:
  beside(model3.ec_lang,
         beside(animate(fun (n): blank(~width: n*100, ~height: 0)),
                switch(animate(~extent: 1,
                               fun (n):
                                 first_term.pad(~right: -(1-n)*first_term.width).clip()).sustain(),
                       second_term.pad(~right: first_term.width - second_term.width))))

def new_rules:
  stack(~sep: 60,
        & model4.ax)


def ex2_with_new_rules:
  stack(model2.ex,
        animate(fun (n): blank(~height: n*60, ~width: 0)),
        animate(fun (n):
                  new_rules.pad(~bottom: -(1-n)*new_rules.height).clip()).sustain())

module main:
  slide(explain_evaluation_contexts)
  slide(ex2_with_new_rules)
