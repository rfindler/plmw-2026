#lang rhombus
import:
  "model-picts.rhm" open
  "state_ex.rhm" open
  "sexp_to_tree.rhm" open
  "trees-with-subtrees.rhm" open
  "explain-evaluation-contexts.rhm" open
  slideshow open

// introduction:
// specification of a programming language starts with a description of its semantics
// but we can actually do the semantics that way too!
// you are familiar with this from grade school: "plug and chug" and simplification of arithmetic.
// mathematically: we are defining a relation that captures a single step of computation
//  and then just taking the trans refl closure to get the complete behavior of a program.

slide(lang1) // a first simple language: booleans
slide(ax1)   // define rules for atomic computation steps: the axioms
slide(ex1)   // what should happen when an axiom is nested: is that always ok?
slide(lang2) // to answer, let’s first add state to the language
slide(ax2)   // the state axioms; also add a store
slide(ax3)   // the other axioms have to adapt
slide(ex2_slide) // let’s return to the question of nesting, but in this example
slide(stack.left(~sep: 80,
                 beside(~sep: 100, ex1 , to_pict(ex1_sexp)),
                 beside(~sep: 100, ex2 , to_pict(ex2_sexp)))) // expressions are really trees
slide(switch(abstract_big_tree(200,200,#false),
             abstract_big_tree(200,200,#true)).scale(2))  // maybe big ones; how do we express the rule?
slide(explain_evaluation_contexts) // evaluation contexts: paths from the root to the axiom use
slide(ex2_with_new_rules)  // those rules aren’t the usual ones: can we fix them?
slide(t("Careful—the next slide has the answer!"))
slide(lang4) // we need only two evaluation contexts


